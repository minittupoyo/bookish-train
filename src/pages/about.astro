---
import Layout from "../layouts/Layout.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

const tools = ["Astro", "Tailwind CSS", "Bun", "Cloudflare Workers", "Arch Linux", "Windows 11", "VS Code / fresh"];

const links = [
    { label: "GitHub", href: "https://github.com/minittupoyo", description: "コードや制作物を見る" },
    { label: "記事一覧", href: "/posts/", description: "これまでに書いた記事を読む" },
];
---

<Layout title="About" description={`${SITE_TITLE}(${SITE_DESCRIPTION})と運営者みにっつについてのページです。`}>
    <div class="mx-auto max-w-5xl px-6 py-14 sm:py-20">
        <header class="grid gap-10 border-b border-zinc-200 pb-12 sm:pb-16 md:grid-cols-[minmax(0,1fr)_18rem] md:items-end">
            <div>
                <p class="text-sm font-semibold tracking-widest text-blue-600 uppercase">About</p>
                <h1 class="mt-4 max-w-2xl text-3xl leading-tight font-bold tracking-tight text-zinc-950 sm:text-5xl">
                    好きなものを、<br class="hidden sm:block" />自分の言葉で記録する。
                </h1>
                <p class="mt-6 max-w-2xl text-base leading-8 text-zinc-600">
                    {SITE_TITLE}は、{SITE_DESCRIPTION}
                    パソコンやWeb、AIの話からゲームや買ったもの、日々考えたことまで、気になったものを雑多に書いています。
                </p>
            </div>

            <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-xs">
                <div class="flex items-center gap-4">
                    <div
                        class="grid size-12 shrink-0 place-items-center rounded-full bg-blue-50 text-lg font-bold text-blue-600"
                        aria-hidden="true"
                    >
                        み
                    </div>
                    <div>
                        <p class="font-semibold text-zinc-950">みにっつ</p>
                        <p class="mt-0.5 text-sm text-zinc-500">個人ブログの運営者</p>
                    </div>
                </div>
                <p class="mt-5 text-sm leading-7 text-zinc-600">
                    パソコンをいじったり、美少女ゲームをやったり、音楽を聴いたりしています。気になったものは、とりあえず触ってみるタイプです。
                </p>
            </div>
        </header>

        <div class="grid gap-12 py-12 sm:py-16 md:grid-cols-[11rem_minmax(0,1fr)] md:gap-16">
            <h2 class="text-sm font-semibold tracking-wide text-zinc-500">プロフィール</h2>
            <div>
                <h3 class="text-2xl font-bold tracking-tight text-zinc-950">こんにちは、みにっつです。</h3>
                <div class="mt-5 space-y-4 text-base leading-8 text-zinc-600">
                    <p>
                        Linuxを入れていじったり、Webサイトを作ったり、自作PCのパーツで悩んだり、AIにコードを書かせたりしています。WindowsとLinuxを行ったり来たりしながら、気になった技術を実際に試すのが好きです。
                    </p>
                    <p>
                        プログラミングは勉強中。全部を自分で書くというより、ChatGPTやCodexなどのAIにもかなり頼りながら作っています。最近はAstroやBunを使ったWeb制作、Linux環境、自宅サーバーあたりを触ることが多めです。
                    </p>
                    <p>
                        このブログは「詳しい人が教える場所」というより、自分が試したこと、ハマったこと、あとで忘れそうな設定や、その時々で考えたことを残しておく場所です。
                    </p>
                </div>
            </div>
        </div>

        <div class="grid gap-12 border-t border-zinc-200 py-12 sm:py-16 md:grid-cols-[11rem_minmax(0,1fr)] md:gap-16">
            <h2 class="text-sm font-semibold tracking-wide text-zinc-500">このブログ</h2>
            <div>
                <h3 class="text-2xl font-bold tracking-tight text-zinc-950">技術ブログというより、個人ブログ。</h3>
                <div class="mt-5 space-y-4 text-base leading-8 text-zinc-600">
                    <p>
                        LinuxやWeb、AI、自作PCなど技術っぽい記事が多いですが、それだけに絞るつもりはありません。ゲーム、買ったもの、音楽、その時に考えていたことなども書きます。
                    </p>
                    <p>
                        ブログ自体はAstro v7とSätteri（Tailwind CSS v4）で構築し、Cloudflare Workersでホスティングしています。ブログそのものも実験場みたいなもので、欲しくなった機能をその都度足しています。
                    </p>
                </div>

                <ul class="mt-8 flex flex-wrap gap-2" aria-label="使用技術・環境">
                    {
                        tools.map((tool) => (
                            <li class="rounded-full border border-zinc-200 bg-white px-3 py-1.5 text-sm text-zinc-600 shadow-xs">{tool}</li>
                        ))
                    }
                </ul>
            </div>
        </div>

        <section class="border-t border-zinc-200 pt-12 sm:pt-16" aria-labelledby="links-heading">
            <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
                <div>
                    <p class="text-sm font-semibold tracking-wide text-zinc-500">Links</p>
                    <h2 id="links-heading" class="mt-2 text-2xl font-bold tracking-tight text-zinc-950">もう少し見る</h2>
                </div>
                <p class="text-sm text-zinc-500">制作物と、このブログの記事へ。</p>
            </div>

            <ul class="mt-8 grid gap-4 sm:grid-cols-2">
                {
                    links.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                class="group flex items-center justify-between gap-4 rounded-2xl border border-zinc-200 bg-white p-5 shadow-xs transition-[border-color,box-shadow] duration-200 hover:border-zinc-300 hover:shadow-md"
                            >
                                <span>
                                    <span class="font-semibold text-zinc-950 transition-colors duration-200 group-hover:text-blue-600">
                                        {link.label}
                                    </span>
                                    <span class="mt-1 block text-sm text-zinc-500">{link.description}</span>
                                </span>
                                <svg
                                    class="size-5 shrink-0 text-zinc-400 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:text-blue-600"
                                    viewBox="0 0 20 20"
                                    fill="none"
                                    aria-hidden="true"
                                >
                                    <path
                                        d="M4 10h12m-5-5 5 5-5 5"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    />
                                </svg>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </section>
    </div>
</Layout>
