---
import { render } from "astro:content";
import { getPosts } from "../../lib/posts";
import Layout from "../../layouts/Layout.astro";
import FormattedDate from "../../components/FormattedDate.astro";

export async function getStaticPaths() {
    const posts = await getPosts();
    return posts.map((entry, i) => ({
        params: { id: entry.id },
        props: {
            entry,
            prev: i < posts.length - 1 ? posts[i + 1] : undefined,
            next: i > 0 ? posts[i - 1] : undefined,
        },
    }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.description}>
    <div class="mx-auto max-w-2xl px-6 py-14 sm:py-20">
        <article>
            <header>
                <FormattedDate date={entry.data.date} class="text-sm font-medium text-zinc-500 tabular-nums" />
                <h1 class="mt-3 text-3xl leading-snug font-bold tracking-tight text-zinc-950 sm:text-4xl">
                    {entry.data.title}
                </h1>
                {
                    entry.data.tags.length > 0 && (
                        <ul class="mt-4 flex flex-wrap gap-2" aria-label="タグ">
                            {entry.data.tags.map((tag) => (
                                <li class="rounded-full border border-zinc-200 bg-white px-2.5 py-0.5 text-xs text-zinc-600">{tag}</li>
                            ))}
                        </ul>
                    )
                }
            </header>

            <div
                class="prose prose-zinc prose-headings:font-bold prose-headings:tracking-tight prose-p:leading-loose prose-a:font-medium prose-a:text-blue-600 prose-a:no-underline hover:prose-a:underline mt-10 max-w-none"
            >
                <Content />
            </div>
        </article>

        {
            (prev || next) && (
                <nav class="mt-16 grid gap-4 sm:grid-cols-2" aria-label="前後の記事">
                    {prev ? (
                        <a
                            href={`/blog/${prev.id}/`}
                            class="group flex cursor-pointer flex-col rounded-2xl border border-zinc-200/70 bg-white p-6 shadow-xs transition-[border-color,box-shadow] duration-200 hover:border-zinc-300 hover:shadow-md"
                        >
                            <span class="text-xs font-medium text-zinc-500">
                                <span aria-hidden="true">&larr;</span> 前の記事
                            </span>
                            <span class="mt-2 line-clamp-2 font-medium leading-snug text-zinc-900 transition-colors duration-200 group-hover:text-blue-600">
                                {prev.data.title}
                            </span>
                        </a>
                    ) : (
                        <span />
                    )}
                    {next && (
                        <a
                            href={`/blog/${next.id}/`}
                            class="group flex cursor-pointer flex-col rounded-2xl border border-zinc-200/70 bg-white p-6 text-right shadow-xs transition-[border-color,box-shadow] duration-200 hover:border-zinc-300 hover:shadow-md"
                        >
                            <span class="text-xs font-medium text-zinc-500">
                                次の記事 <span aria-hidden="true">&rarr;</span>
                            </span>
                            <span class="mt-2 line-clamp-2 font-medium leading-snug text-zinc-900 transition-colors duration-200 group-hover:text-blue-600">
                                {next.data.title}
                            </span>
                        </a>
                    )}
                </nav>
            )
        }

        <footer class="mt-16 border-t border-zinc-200 pt-8">
            <a
                href="/"
                class="inline-flex cursor-pointer items-center gap-1.5 text-sm font-medium text-zinc-600 transition-colors duration-200 hover:text-blue-600"
            >
                <span aria-hidden="true">&larr;</span>
                記事一覧に戻る
            </a>
        </footer>
    </div>
</Layout>
