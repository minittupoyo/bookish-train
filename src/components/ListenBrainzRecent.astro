---
interface Props {
    username: string;
    count?: number;
}

const { username, count = 5 } = Astro.props;
const profileUrl = `https://listenbrainz.org/user/${encodeURIComponent(username)}/`;
---

<section class="mt-14 border-t border-zinc-200 pt-10" data-listenbrainz data-username={username} data-count={count}>
    <div class="flex items-end justify-between gap-4">
        <div>
            <p class="text-xs font-medium tracking-wide text-zinc-500">ListenBrainz</p>
            <h2 class="mt-1 text-xl font-semibold tracking-tight text-zinc-900">最近聴いた曲</h2>
        </div>
        <a
            href={profileUrl}
            target="_blank"
            rel="noreferrer"
            class="text-sm text-zinc-500 underline decoration-zinc-300 underline-offset-4 transition-colors hover:text-blue-600"
        >
            プロフィールを見る
        </a>
    </div>

    <div class="mt-5 hidden rounded-2xl border border-blue-200 bg-blue-50/60 p-4" data-listenbrainz-now-playing aria-live="polite">
        <div class="mb-3 flex items-center gap-2 text-xs font-medium text-blue-700">
            <span class="relative flex size-2" aria-hidden="true">
                <span class="absolute inline-flex size-full animate-ping rounded-full bg-blue-500 opacity-60"></span>
                <span class="relative inline-flex size-2 rounded-full bg-blue-600"></span>
            </span>
            Now Playing
        </div>
        <div class="flex items-center gap-4" data-listenbrainz-now-playing-track></div>
    </div>

    <p class="mt-5 text-sm text-zinc-500" data-listenbrainz-status aria-live="polite">ListenBrainz から取得中...</p>
    <ol class="mt-5 hidden divide-y divide-zinc-100 overflow-hidden rounded-2xl border border-zinc-200/70 bg-white" data-listenbrainz-list aria-label="最近聴いた曲"></ol>
</section>

<script>
    interface ListenBrainzMbidMapping {
        caa_id?: number;
        caa_release_mbid?: string;
    }

    interface ListenBrainzTrackMetadata {
        artist_name?: string;
        track_name?: string;
        release_name?: string;
        mbid_mapping?: ListenBrainzMbidMapping;
    }

    interface ListenBrainzListen {
        listened_at?: number;
        track_metadata?: ListenBrainzTrackMetadata;
    }

    interface ListenBrainzResponse {
        payload?: {
            listens?: ListenBrainzListen[];
            playing_now?: boolean;
        };
    }

    const formatListenedAt = (timestamp?: number) => {
        if (!timestamp) return "再生時刻不明";

        return new Intl.DateTimeFormat("ja-JP", {
            month: "short",
            day: "numeric",
            hour: "2-digit",
            minute: "2-digit",
        }).format(new Date(timestamp * 1000));
    };

    const getCoverArtUrl = (metadata: ListenBrainzTrackMetadata) => {
        const mapping = metadata.mbid_mapping;
        if (!mapping?.caa_id || !mapping.caa_release_mbid) return null;

        return `https://coverartarchive.org/release/${encodeURIComponent(mapping.caa_release_mbid)}/${encodeURIComponent(String(mapping.caa_id))}-250.jpg`;
    };

    const createCover = (metadata: ListenBrainzTrackMetadata, sizeClass: string) => {
        const cover = document.createElement("div");
        cover.className = `flex ${sizeClass} shrink-0 items-center justify-center overflow-hidden rounded-lg bg-zinc-100 text-zinc-400`;

        const coverUrl = getCoverArtUrl(metadata);
        if (coverUrl) {
            const image = document.createElement("img");
            image.src = coverUrl;
            image.alt = metadata.release_name ? `${metadata.release_name} のジャケット` : "アルバムジャケット";
            image.className = "size-full object-cover";
            image.loading = "lazy";
            image.decoding = "async";
            image.addEventListener("error", () => image.remove(), { once: true });
            cover.append(image);
        }

        return cover;
    };

    const createTrackText = (metadata: ListenBrainzTrackMetadata, titleClass = "truncate text-sm font-medium text-zinc-900") => {
        const track = document.createElement("div");
        track.className = "min-w-0 flex-1";

        const title = document.createElement("p");
        title.className = titleClass;
        title.textContent = metadata.track_name || "曲名不明";

        const details = document.createElement("p");
        details.className = "mt-1 truncate text-xs text-zinc-500";
        details.textContent = [metadata.artist_name, metadata.release_name].filter(Boolean).join(" · ") || "アーティスト不明";

        track.append(title, details);
        return track;
    };

    const renderListen = (listen: ListenBrainzListen) => {
        const metadata = listen.track_metadata ?? {};
        const item = document.createElement("li");
        item.className = "flex items-center gap-4 px-4 py-4 sm:px-5";

        const listenedAt = document.createElement("time");
        listenedAt.className = "shrink-0 text-xs text-zinc-400 tabular-nums";
        listenedAt.textContent = formatListenedAt(listen.listened_at);
        if (listen.listened_at) listenedAt.dateTime = new Date(listen.listened_at * 1000).toISOString();

        item.append(createCover(metadata, "size-14"), createTrackText(metadata), listenedAt);
        return item;
    };

    const loadNowPlaying = async (section: HTMLElement) => {
        const username = section.dataset.username;
        const nowPlaying = section.querySelector<HTMLElement>("[data-listenbrainz-now-playing]");
        const trackContainer = section.querySelector<HTMLElement>("[data-listenbrainz-now-playing-track]");
        if (!username || !nowPlaying || !trackContainer) return;

        try {
            const response = await fetch(`https://api.listenbrainz.org/1/user/${encodeURIComponent(username)}/playing-now`, {
                headers: { Accept: "application/json" },
            });

            if (!response.ok) throw new Error(`ListenBrainz playing-now API returned ${response.status}`);

            const data = (await response.json()) as ListenBrainzResponse;
            const listen = data.payload?.playing_now ? data.payload.listens?.[0] : undefined;

            if (!listen) {
                nowPlaying.classList.add("hidden");
                trackContainer.replaceChildren();
                return;
            }

            const metadata = listen.track_metadata ?? {};
            trackContainer.replaceChildren(
                createCover(metadata, "size-16 sm:size-20"),
                createTrackText(metadata, "truncate text-base font-semibold text-zinc-950 sm:text-lg"),
            );
            nowPlaying.classList.remove("hidden");
        } catch (error) {
            console.error("Failed to load ListenBrainz now playing", error);
            nowPlaying.classList.add("hidden");
        }
    };

    const loadRecentListens = async (section: HTMLElement) => {
        const username = section.dataset.username;
        const count = Number(section.dataset.count ?? "5");
        const status = section.querySelector<HTMLElement>("[data-listenbrainz-status]");
        const list = section.querySelector<HTMLOListElement>("[data-listenbrainz-list]");
        if (!username || !status || !list) return;

        try {
            const response = await fetch(
                `https://api.listenbrainz.org/1/user/${encodeURIComponent(username)}/listens?count=${encodeURIComponent(String(count))}`,
                { headers: { Accept: "application/json" } },
            );

            if (!response.ok) throw new Error(`ListenBrainz API returned ${response.status}`);

            const data = (await response.json()) as ListenBrainzResponse;
            const listens = data.payload?.listens ?? [];

            if (listens.length === 0) {
                status.textContent = "最近の再生履歴はありません。";
                return;
            }

            list.replaceChildren(...listens.map(renderListen));
            list.classList.remove("hidden");
            status.classList.add("hidden");
        } catch (error) {
            console.error("Failed to load ListenBrainz listens", error);
            status.textContent = "再生履歴を取得できませんでした。";
        }
    };

    document.querySelectorAll<HTMLElement>("[data-listenbrainz]").forEach((section) => {
        void Promise.all([loadNowPlaying(section), loadRecentListens(section)]);

        window.setInterval(() => {
            if (document.visibilityState === "visible") void loadNowPlaying(section);
        }, 30_000);
    });
</script>
