---
import { SITE_TITLE } from "../consts";

const pathname = Astro.url.pathname;
const links = [
    { href: "/posts/", label: "記事一覧", active: pathname.startsWith("/posts") },
    { href: "/about/", label: "About", active: pathname.startsWith("/about") },
];
---

<header class="border-b border-[#e8dfe1] bg-[#fff8f7]/90 backdrop-blur-sm">
    <div class="mx-auto flex h-20 max-w-5xl items-center justify-between px-6">
        <a
            href="/"
            class="cursor-pointer text-[15px] font-bold tracking-tight text-[#211a1d] transition-colors duration-200 hover:text-[#6750a4]"
        >
            {SITE_TITLE}
        </a>
            <nav aria-label="メインナビゲーション" class="flex items-center gap-2">
            {
                links.map((link) => (
                    <a
                        href={link.href}
                        aria-current={link.active ? "page" : undefined}
                        class:list={[
                            "cursor-pointer rounded-full px-4 py-2 text-sm transition-colors duration-200 hover:bg-[#f9e9e8] hover:text-[#6750a4]",
                            link.active ? "bg-[#eaddff] font-semibold text-[#6750a4]" : "text-[#51474a]",
                        ]}
                    >
                        {link.label}
                    </a>
                ))
            }
        </nav>
    </div>
</header>
