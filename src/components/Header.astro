---
import { SITE_TITLE } from "../consts";

const pathname = Astro.url.pathname;
const links = [
    { href: "/posts/", label: "記事一覧", active: pathname.startsWith("/posts") },
    { href: "/about/", label: "About", active: pathname.startsWith("/about") },
];
---

<header class="border-b border-zinc-200">
    <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-6">
        <a
            href="/"
            class="cursor-pointer text-[15px] font-semibold tracking-tight text-zinc-950 transition-colors duration-200 hover:text-blue-600"
        >
            {SITE_TITLE}
        </a>
        <nav aria-label="メインナビゲーション" class="flex items-center gap-5">
            {
                links.map((link) => (
                    <a
                        href={link.href}
                        aria-current={link.active ? "page" : undefined}
                        class:list={[
                            "cursor-pointer text-sm transition-colors duration-200 hover:text-blue-600",
                            link.active ? "font-medium text-blue-600" : "text-zinc-600",
                        ]}
                    >
                        {link.label}
                    </a>
                ))
            }
        </nav>
    </div>
</header>
