---
import { SITE_TITLE } from "../consts";

const isHome = Astro.url.pathname === "/";
---

<header class="border-b border-zinc-200">
    <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-6">
        <a
            href="/"
            class="cursor-pointer text-[15px] font-semibold tracking-tight text-zinc-950 transition-colors duration-200 hover:text-blue-600"
        >
            {SITE_TITLE}
        </a>
        <nav aria-label="メインナビゲーション">
            <a
                href="/"
                aria-current={isHome ? "page" : undefined}
                class="cursor-pointer text-sm text-zinc-600 transition-colors duration-200 hover:text-blue-600"
            >
                記事一覧
            </a>
        </nav>
    </div>
</header>
