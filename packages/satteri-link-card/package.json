{
    "name": "@minittupoyo/satteri-link-card",
    "version": "1.0.0",
    "description": "Satteri plugin that converts standalone URL paragraphs into OGP link cards",
    "type": "module",
    "main": "./src/index.js",
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "default": "./src/index.js"
        }
    },
